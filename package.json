{
  "name": "voxel-game",
  "private": true,
  "version": "2.0.0",
  "description": "Original 3D Voxel Sandbox Desktop & Web Game (Three.js + Vite + Electron + Web Workers)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/fluids.test.js && node tests/animals.test.js && node tests/time.test.js && node tests/lightning.test.js",
    "app:dev": "electron .",
    "app:build": "vite build",
    "app:pack": "vite build && electron-builder --dir",
    "app:dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.antigravity.voxelrealms",
    "productName": "Voxel Realms",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  }
}
